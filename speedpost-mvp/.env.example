PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Meta / Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
INSTAGRAM_GRAPH_VERSION=v24.0

# GitHub Releases usado apenas como storage temporario no MVP
GITHUB_TOKEN=
GITHUB_OWNER=minhaversao
GITHUB_REPO=bolado
GITHUB_RELEASE_TAG=rap-talis-media

# 32 bytes em hexadecimal (64 caracteres). Ex.: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# String aleatoria usada para assinar o state do OAuth
SESSION_SECRET=

DATABASE_PATH=./data/scheduler.db
